[gd_scene load_steps=5 format=3]

[ext_resource type="Script" path="res://ui/hud/building_panel/building_panel.gd" id="1_script"]
[ext_resource type="StyleBoxFlat" path="res://ui/hud/minimap/minimap_frame_style.tres" id="2_frame"]
[ext_resource type="StyleBoxFlat" path="res://ui/styles/button_normal_style.tres" id="3_button"]
[ext_resource type="StyleBoxFlat" path="res://ui/styles/button_hover_style.tres" id="4_button_hover"]

[node name="BuildingPanel" type="Control"]
custom_minimum_size = Vector2(260, 224)
layout_mode = 3
anchors_preset = 0
mouse_filter = 2
script = ExtResource("1_script")

[node name="Frame" type="Panel" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
mouse_filter = 2
theme_override_styles/panel = ExtResource("2_frame")

[node name="Margin" type="MarginContainer" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
mouse_filter = 2
theme_override_constants/margin_left = 10
theme_override_constants/margin_top = 8
theme_override_constants/margin_right = 10
theme_override_constants/margin_bottom = 8

[node name="VBox" type="VBoxContainer" parent="Margin"]
layout_mode = 2
mouse_filter = 2
theme_override_constants/separation = 4

[node name="CrystalsLabel" type="Label" parent="Margin/VBox"]
unique_name_in_owner = true
layout_mode = 2
theme_override_font_sizes/font_size = 16
text = "Crystals: 0"

[node name="InfoLabel" type="Label" parent="Margin/VBox"]
unique_name_in_owner = true
layout_mode = 2
theme_override_font_sizes/font_size = 12
autowrap_mode = 2
text = "Select a structure to build"

[node name="Buttons" type="HBoxContainer" parent="Margin/VBox"]
layout_mode = 2
mouse_filter = 2
theme_override_constants/separation = 6

[node name="WallButton" type="Button" parent="Margin/VBox/Buttons"]
unique_name_in_owner = true
custom_minimum_size = Vector2(76, 64)
layout_mode = 2
theme_override_styles/normal = ExtResource("3_button")
theme_override_styles/hover = ExtResource("4_button_hover")
theme_override_styles/pressed = ExtResource("4_button_hover")
toggle_mode = true
expand_icon = false
text = "Wall"
[node name="TowerButton" type="Button" parent="Margin/VBox/Buttons"]
unique_name_in_owner = true
custom_minimum_size = Vector2(76, 64)
layout_mode = 2
theme_override_styles/normal = ExtResource("3_button")
theme_override_styles/hover = ExtResource("4_button_hover")
theme_override_styles/pressed = ExtResource("4_button_hover")
toggle_mode = true
expand_icon = false
text = "Tower"
[node name="MineButton" type="Button" parent="Margin/VBox/Buttons"]
unique_name_in_owner = true
custom_minimum_size = Vector2(76, 64)
layout_mode = 2
theme_override_styles/normal = ExtResource("3_button")
theme_override_styles/hover = ExtResource("4_button_hover")
theme_override_styles/pressed = ExtResource("4_button_hover")
toggle_mode = true
expand_icon = false
text = "Mine"
[node name="SelectedSection" type="VBoxContainer" parent="Margin/VBox"]
unique_name_in_owner = true
layout_mode = 2
mouse_filter = 2
theme_override_constants/separation = 2

[node name="SelectedName" type="Label" parent="Margin/VBox/SelectedSection"]
unique_name_in_owner = true
layout_mode = 2
theme_override_font_sizes/font_size = 14
text = "Building"

[node name="SelectedHp" type="Label" parent="Margin/VBox/SelectedSection"]
unique_name_in_owner = true
layout_mode = 2
theme_override_font_sizes/font_size = 12
text = "HP 0 / 0"

[node name="SelectedButtons" type="HBoxContainer" parent="Margin/VBox/SelectedSection"]
layout_mode = 2
mouse_filter = 2
theme_override_constants/separation = 6

[node name="UpgradeButton" type="Button" parent="Margin/VBox/SelectedSection/SelectedButtons"]
unique_name_in_owner = true
layout_mode = 2
