; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[animation]

compatibility/default_parent_skeleton_in_mesh_instance_3d=true

[application]

config/name="catchNrun"
run/main_scene="uid://cly3lyw5o6gr7"
config/features=PackedStringArray("4.7", "GL Compatibility")
config/icon="res://assets/textures/icon.svg"

[autoload]

LaunchOptions="*res://autoloads/launch_options.gd"
NetworkManager="*res://autoloads/network_manager.gd"
GameManager="*res://autoloads/game_manager.gd"
SceneTransitionManager="*res://autoloads/scene_transition_manager.gd"
SettingsManager="*res://autoloads/settings_manager.gd"
SoundManager="*res://autoloads/sound_manager.gd"
BotClient="*res://tests/bots/bot_client.gd"
Sandbox="*res://game/sandbox/sandbox_panel.gd"

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/stretch/mode="canvas_items"

[file_customization]

folder_colors={
"res://assets/": "orange",
"res://autoloads/": "pink",
"res://game/": "green",
"res://ui/": "yellow"
}

[layer_names]

2d_physics/layer_1="world"
2d_physics/layer_2="obstacle"
2d_physics/layer_3="unit"
2d_physics/layer_4="building"
2d_physics/layer_5="destructible"
2d_physics/layer_6="item"

[network]

server_url=""

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
